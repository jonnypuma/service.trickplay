<?xml version="1.0" encoding="UTF-8"?>
<!--
  Arctic Zephyr: Rounded (skin.arctic.zephyr.rounded).
  Continuous PreviewLeft/Top (94100); lifts -74px with full video OSD.
  Source: github.com/Nanomani/skin.arctic.zephyr.rounded 1080i/Includes_OSD.xml
  trickplay-overlay-rev:5

  Copy group 94090 below into your skin DialogSeekBar.xml (top-level control).
-->
<window>
	<controls>
		<control type="group" id="94090">
			<!-- trickplay-overlay-rev:5 -->
			<zorder>999</zorder>
			<control type="group" id="94100">
				<visible>!String.IsEmpty(Window(Home).Property(Trickplay.PreviewImage)) + [String.IsEqual(Window(Home).Property(Trickplay.PreviewVisible),true) | Player.Seeking]</visible>
				<left>$INFO[Window(Home).Property(Trickplay.PreviewLeft)]</left>
				<top>$INFO[Window(Home).Property(Trickplay.PreviewTop)]</top>
				<width>320</width>
				<height condition="String.IsEqual(Window(Home).Property(Trickplay.ShowTimestamp),true)">220</height>
				<height condition="!String.IsEqual(Window(Home).Property(Trickplay.ShowTimestamp),true)">180</height>
				<animation effect="slide" start="0" end="0,-74" time="150" condition="Window.IsVisible(videoosd) + !Window.IsVisible(VideoOSDBookmarks.xml)">Conditional</animation>
				<animation effect="fade" start="0" end="100" time="100">Visible</animation>
				<animation effect="fade" start="100" end="0" time="100">Hidden</animation>
				<control type="image" id="94106">
					<left>0</left>
					<top>0</top>
					<width>320</width>
					<height>180</height>
					<aspectratio scalediffuse="false">keep</aspectratio>
					<bordertexture border="2" infill="false">progress/progress-bg.png</bordertexture>
					<bordersize>2</bordersize>
					<colordiffuse>B3FFFFFF</colordiffuse>
				</control>
				<control type="image" id="94101">
					<left>0</left>
					<top>0</top>
					<width>320</width>
					<height>180</height>
					<aspectratio scalediffuse="false">keep</aspectratio>
					<texture background="true">$INFO[Window(Home).Property(Trickplay.PreviewImage)]</texture>
				</control>
				<control type="label" id="94102">
					<visible>String.IsEqual(Window(Home).Property(Trickplay.ShowTimestamp),true)</visible>
					<left>0</left>
					<top>180</top>
					<width>320</width>
					<height>40</height>
					<font>font13</font>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[Window(Home).Property(Trickplay.PreviewTime)]</label>
					<textcolor>FFFFFFFF</textcolor>
					<shadowcolor>FF000000</shadowcolor>
					<shadowoffsetx>2</shadowoffsetx>
					<shadowoffsety>2</shadowoffsety>
				</control>
			</control>
		</control>
	</controls>
</window>
