<?xml version="1.0" encoding="UTF-8"?>
<window>
    <zorder>0</zorder>
    <visible>Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)</visible>

    <visible>[Player.Paused + [!$EXP[Exp_OSD_DelayInfo_Timing] | !Skin.String(OSD.AutoOnPause,Hide)]] | Player.Caching | Player.Seeking | Player.HasPerformedSeek(2) | Player.Forwarding | Player.Rewinding | !String.IsEmpty(Player.SeekNumeric) | !String.IsEmpty(PVR.ChannelNumberInput) | Window.IsActive(script-upnext-stillwatching.xml) | Window.IsActive(script-upnext-upnext.xml) | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(1140) | Window.IsActive(1141) | Window.IsActive(1142) | Window.IsActive(1143) | Window.IsActive(1144) | Window.IsActive(1145) | Window.IsActive(1146) | Window.IsActive(1147) | Window.IsActive(1148) | Window.IsActive(1149) | Window.IsActive(1152) | Window.IsVisible(videobookmarks) | Window.IsVisible(pvrosdguide) | Window.IsVisible(pvrosdchannels) | [Window.IsVisible(script-cu-lrclyrics-main.xml) + Player.ShowInfo]</visible>

    <visible>!Window.IsActive(DialogSlider.xml)</visible>
    <visible>!Player.HasGame</visible>
    <visible>!Window.IsVisible(DialogPlayerProcessInfo.xml)</visible>
    <visible>String.IsEmpty(Window(Home).Property(Skippy.Skipping))</visible>

    <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
    <controls>

        <control type="group">
            <visible>Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)</visible>

            <include>OSD_BackgroundFade_Seekbar</include>

            <control type="group">
                <visible>!Window.IsVisible(1152)</visible>
                <include>Animation_OSD_Fullscreen_Change</include>

                <control type="group">
                    <include>Animation_OSD_HideForInfoDialog</include>
                    <control type="group">
                        <include>Animation_OSD_Seekbar_Slide</include>
                        <include>OSD_Progress_Labels</include>
                        <include>OSD_Progress_Bar</include>

                        <control type="group">
                            <include>OSD_HideControls</include>
                            <include content="Furniture_Header">
                                <param name="label">$VAR[Label_OSD_Header]</param>
                                <param name="include_right">false</param>
                                <param name="textcolor">panel_fg_90</param>
                                <param name="top">780</param>
                            </include>
                        </control>
                    </control>

                    <include content="OSD_CastInfo_HintText">
                        <param name="label">$VAR[Label_OSD_HintText]</param>
                        <param name="visible">[Window.IsActive(videoosd) | Window.IsVisible(1140) | Window.IsVisible(1141) | Window.IsVisible(videobookmarks)] + [!Window.IsVisible(1141) | Skin.String(VideoOSD.PersonCredits.CastCrew,cast)]</param>
                    </include>

                    <include content="OSD_CastInfo_HintText">
                        <param name="label">$LOCALIZE[31346]</param>
                        <param name="visible">Window.IsActive(musicosd) + !Window.IsVisible(1142) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</param>
                    </include>
                </control>

                <include content="Furniture_Header">
                    <param name="include_left">false</param>
                    <param name="textcolor">panel_fg_90</param>
                </include>


            </control>
        </control>

        <!-- Trickplay preview overlay (service.trickplay). Copy group 94090 into skin DialogSeekBar.xml. -->
        <!-- Compact seek bar: group 94100 (anchor 270,670, continuous PreviewLeft/Top). Full OSD: group 94103 (800,670, centered above bar). -->
        <!-- Matched automatically when skin.arctic.fuse.3 is active (see skin_profiles.py). -->
        <!-- trickplay-overlay-rev:5 -->
        <control type="group" id="94090">
            <control type="group" id="94100">
                <visible>String.IsEqual(Window.Property(Trickplay.PreviewVisible),true) + !String.IsEmpty(Window.Property(Trickplay.PreviewImage)) + !String.IsEqual(Window.Property(Trickplay.PreviewLayout),center)</visible>
                <left>$INFO[Window.Property(Trickplay.PreviewLeft)]</left>
                <top>$INFO[Window.Property(Trickplay.PreviewTop)]</top>
                <width>320</width>
                <height condition="String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">224</height>
                <height condition="!String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">180</height>
                <zorder>10</zorder>
                <colordiffuse>$INFO[Window.Property(Trickplay.PreviewColorDiffuse)]</colordiffuse>
                <animation effect="fade" start="0" end="100" time="100">Visible</animation>
                <animation effect="fade" start="100" end="0" time="100">Hidden</animation>
                <control type="image" id="94106">
                    <left>0</left>
                    <top>0</top>
                    <width>320</width>
                    <height>180</height>
                    <aspectratio scalediffuse="false">keep</aspectratio>
                    <bordertexture border="2" infill="false">common/white.png</bordertexture>
                    <bordersize>2</bordersize>
                    <colordiffuse>panel_fg_70</colordiffuse>
                </control>
                <control type="image" id="94101">
                    <left>0</left>
                    <top>0</top>
                    <width>$INFO[Window.Property(Trickplay.PreviewWidth)]</width>
                    <height>$INFO[Window.Property(Trickplay.PreviewHeight)]</height>
                    <aspectratio scalediffuse="false">keep</aspectratio>
                    <texture background="true">$INFO[Window.Property(Trickplay.PreviewImage)]</texture>
                </control>
                <control type="label" id="94102">
                    <visible>String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)</visible>
                    <left>0</left>
                    <top>180</top>
                    <width>320</width>
                    <height>40</height>
                    <font>font_main</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(Trickplay.PreviewTime)]</label>
                    <textcolor>panel_fg_100</textcolor>
                </control>
            </control>
            <control type="group" id="94103">
                <visible>String.IsEqual(Window.Property(Trickplay.PreviewVisible),true) + !String.IsEmpty(Window.Property(Trickplay.PreviewImage)) + String.IsEqual(Window.Property(Trickplay.PreviewLayout),center)</visible>
                <left>800</left>
                <top>670</top>
                <width>320</width>
                <height condition="String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">224</height>
                <height condition="!String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">180</height>
                <zorder>10</zorder>
                <colordiffuse>$INFO[Window.Property(Trickplay.PreviewColorDiffuse)]</colordiffuse>
                <animation effect="fade" start="0" end="100" time="100">Visible</animation>
                <animation effect="fade" start="100" end="0" time="100">Hidden</animation>
                <control type="image" id="94116">
                    <left>0</left>
                    <top>0</top>
                    <width>320</width>
                    <height>180</height>
                    <aspectratio scalediffuse="false">keep</aspectratio>
                    <bordertexture border="2" infill="false">common/white.png</bordertexture>
                    <bordersize>2</bordersize>
                    <colordiffuse>panel_fg_70</colordiffuse>
                </control>
                <control type="image" id="94111">
                    <left>0</left>
                    <top>0</top>
                    <width>$INFO[Window.Property(Trickplay.PreviewWidth)]</width>
                    <height>$INFO[Window.Property(Trickplay.PreviewHeight)]</height>
                    <aspectratio scalediffuse="false">keep</aspectratio>
                    <texture background="true">$INFO[Window.Property(Trickplay.PreviewImage)]</texture>
                </control>
                <control type="label" id="94112">
                    <visible>String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)</visible>
                    <left>0</left>
                    <top>180</top>
                    <width>320</width>
                    <height>40</height>
                    <font>font_main</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(Trickplay.PreviewTime)]</label>
                    <textcolor>panel_fg_100</textcolor>
                </control>
            </control>
        </control>
    </controls>
</window>
