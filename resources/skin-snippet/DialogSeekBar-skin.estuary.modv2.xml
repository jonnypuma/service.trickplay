<?xml version="1.0" encoding="UTF-8"?>
<window>
	<visible>$EXP[isSeeking] | [Player.Paused + !Skin.HasSetting(Hide_OSDInfo)] | Player.ShowInfo | Player.ShowTime | Window.IsVisible(fullscreeninfo) | Window.IsVisible(videoosd) | Window.IsVisible(musicosd) | Window.IsVisible(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric) | !String.IsEmpty(PVR.ChannelNumberInput)</visible>
	<visible>![Window.IsVisible(sliderdialog) | Window.IsVisible(pvrosdchannels) | Window.IsVisible(pvrradiordsinfo) | Window.IsVisible(1135) | Window.IsVisible(1141)]</visible>
	<visible>Window.IsVisible(fullscreenvideo) | Window.IsVisible(visualisation) | Window.IsVisible(1138)</visible>
	<visible>String.IsEmpty(Window(Home).Property(Skippy.Skipping))</visible>
	<include>Animation_BottomFadeInOut</include>
	<depth>DepthOSD</depth>
	<zorder>0</zorder>
	<controls>
		<include>PVRChannelNumberInput</include>
		<control type="group">
			<animation effect="slide" end="0,-140" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31476])">Conditional</animation>
			<animation effect="slide" end="0,-135" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31479])">Conditional</animation>
			<animation effect="slide" end="0,-131.5" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31475])">Conditional</animation>
			<animation effect="slide" end="0,-21" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31478])">Conditional</animation>
			<include content="SeekBar" condition="Skin.HasSetting(ShowSeekBar) + Skin.HasSetting(SmallOSDVideo) + $EXP[isSeeking]">
				<param name="top">990</param>
				<param name="left">30</param>
			</include>
			<include content="SeekBar" condition="Skin.HasSetting(ShowSeekBar) + !Skin.HasSetting(SmallOSDVideo) + $EXP[isSeeking]">
				<param name="top">990</param>
				<param name="left">460</param>
			</include>
			<control type="group">
				<left>30</left>
				<bottom>8</bottom>
				<width>402</width>
				<include content="ItemHeight" condition="!Pvr.IsTimeShift">
					<param name="height">132</param>
				</include>
				<include content="ItemHeight" condition="Pvr.IsTimeShift">
					<param name="height">182</param>
				</include>
				<visible>Skin.HasSetting(ShowSeekBar) + !Skin.HasSetting(SmallOSDVideo) + $EXP[isSeeking]</visible>
				<control type="image">
					<texture  colordiffuse="$VAR[SeekBarOpacityVar]">dialogs/dialog-bg-nobo.png</texture>
				</control>
				<control type="textbox">
					<left>5</left>
					<right>5</right>
					<top>12</top>
					<bottom>12</bottom>
					<font>font14</font>
					<autoscroll delay="2000" time="3000" repeat="20000">Skin.HasSetting(autoscroll)</autoscroll>
					<label>[B]$INFO[VideoPlayer.Season,,x]$INFO[VideoPlayer.Episode,, - ]$INFO[VideoPlayer.Title][/B]</label>
					<align>center</align>
					<aligny>center</aligny>
				</control>
			</control>
			<include condition="Player.HasAudio + !Player.HasVideo">OSDWithInfo</include>
			<include condition="!$EXP[isSeeking] + !Skin.HasSetting(SmallOSDVideo) + Window.IsVisible(fullscreenvideo) + !Window.IsActive(fullscreeninfo)">OSDWithInfo</include>
			<include condition="!Skin.HasSetting(ShowSeekBar) + !Skin.HasSetting(SmallOSDVideo) + Window.IsVisible(fullscreenvideo) + !Window.IsActive(fullscreeninfo)">OSDWithInfo</include>
			<include condition="!$EXP[isSeeking] + Skin.HasSetting(SmallOSDVideo) + Window.IsVisible(fullscreenvideo) + !Window.IsActive(fullscreeninfo)">OSDWithoutInfo</include>
			<include condition="!Skin.HasSetting(ShowSeekBar) + Skin.HasSetting(SmallOSDVideo) + Window.IsVisible(fullscreenvideo) + !Window.IsActive(fullscreeninfo)">OSDWithoutInfo</include>
		</control>
		<!-- Trickplay overlay: separate top-level group so it draws above OSDWithInfo (poster, metadata). -->
		<!-- trickplay-overlay-rev:5 -->
		<control type="group" id="94090">
			<animation effect="slide" end="0,-140" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31476])">Conditional</animation>
			<animation effect="slide" end="0,-135" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31479])">Conditional</animation>
			<animation effect="slide" end="0,-131.5" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31475])">Conditional</animation>
			<animation effect="slide" end="0,-21" time="0" condition="Window.IsVisible(fullscreenvideo) + Skin.HasSetting(ScopeMode) + String.IsEqual(Skin.String(scope_mode),$LOCALIZE[31478])">Conditional</animation>
			<!-- Normal seek bar (continuous PreviewLeft/Top, +30px right vs seek bar left). -->
			<control type="group" id="94100">
				<visible>String.IsEqual(Window.Property(Trickplay.PreviewVisible),true) + !String.IsEmpty(Window.Property(Trickplay.PreviewImage)) + !Skin.HasSetting(SmallOSDVideo)</visible>
				<left>$INFO[Window.Property(Trickplay.PreviewLeft)]</left>
				<top>$INFO[Window.Property(Trickplay.PreviewTop)]</top>
				<width>320</width>
				<height condition="String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">224</height>
				<height condition="!String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">180</height>
				<zorder>10</zorder>
				<colordiffuse>$INFO[Window.Property(Trickplay.PreviewColorDiffuse)]</colordiffuse>
				<animation effect="fade" start="0" end="100" time="100">Visible</animation>
				<animation effect="fade" start="100" end="0" time="100">Hidden</animation>
				<control type="image" id="94106">
					<left>0</left>
					<top>0</top>
					<width>320</width>
					<height>180</height>
					<aspectratio scalediffuse="false">keep</aspectratio>
					<bordertexture border="2" infill="false">colors/white.png</bordertexture>
					<bordersize>2</bordersize>
					<colordiffuse>B3FFFFFF</colordiffuse>
				</control>
				<control type="image" id="94101">
					<left>0</left>
					<top>0</top>
					<width>$INFO[Window.Property(Trickplay.PreviewWidth)]</width>
					<height>$INFO[Window.Property(Trickplay.PreviewHeight)]</height>
					<aspectratio scalediffuse="false">keep</aspectratio>
					<texture background="true">$INFO[Window.Property(Trickplay.PreviewImage)]</texture>
				</control>
				<control type="label" id="94102">
					<visible>String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)</visible>
					<left>0</left>
					<top>180</top>
					<width>320</width>
					<height>40</height>
					<font>font13</font>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(Trickplay.PreviewTime)]</label>
					<textcolor>FFFFFFFF</textcolor>
					<shadowcolor>FF000000</shadowcolor>
					<shadowoffsetx>2</shadowoffsetx>
					<shadowoffsety>2</shadowoffsety>
				</control>
			</control>
			<!-- Small/wide seek bar (+30px right vs seek bar left). -->
			<control type="group" id="94103">
				<visible>String.IsEqual(Window.Property(Trickplay.PreviewVisible),true) + !String.IsEmpty(Window.Property(Trickplay.PreviewImage)) + Skin.HasSetting(SmallOSDVideo)</visible>
				<left>$INFO[Window.Property(Trickplay.PreviewLeftWide)]</left>
				<top>$INFO[Window.Property(Trickplay.PreviewTop)]</top>
				<width>320</width>
				<height condition="String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">224</height>
				<height condition="!String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)">180</height>
				<zorder>10</zorder>
				<colordiffuse>$INFO[Window.Property(Trickplay.PreviewColorDiffuse)]</colordiffuse>
				<animation effect="fade" start="0" end="100" time="100">Visible</animation>
				<animation effect="fade" start="100" end="0" time="100">Hidden</animation>
				<control type="image" id="94107">
					<left>0</left>
					<top>0</top>
					<width>320</width>
					<height>180</height>
					<aspectratio scalediffuse="false">keep</aspectratio>
					<bordertexture border="2" infill="false">colors/white.png</bordertexture>
					<bordersize>2</bordersize>
					<colordiffuse>B3FFFFFF</colordiffuse>
				</control>
				<control type="image" id="94104">
					<left>0</left>
					<top>0</top>
					<width>$INFO[Window.Property(Trickplay.PreviewWidth)]</width>
					<height>$INFO[Window.Property(Trickplay.PreviewHeight)]</height>
					<aspectratio scalediffuse="false">keep</aspectratio>
					<texture background="true">$INFO[Window.Property(Trickplay.PreviewImage)]</texture>
				</control>
				<control type="label" id="94105">
					<visible>String.IsEqual(Window.Property(Trickplay.ShowTimestamp),true)</visible>
					<left>0</left>
					<top>180</top>
					<width>320</width>
					<height>40</height>
					<font>font13</font>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(Trickplay.PreviewTime)]</label>
					<textcolor>FFFFFFFF</textcolor>
					<shadowcolor>FF000000</shadowcolor>
					<shadowoffsetx>2</shadowoffsetx>
					<shadowoffsety>2</shadowoffsety>
				</control>
			</control>
		</control>
	</controls>
</window>
